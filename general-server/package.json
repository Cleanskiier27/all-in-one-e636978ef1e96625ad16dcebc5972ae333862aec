{
  "name": "deployment-ready-app",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Node.js app template for Render, Vercel, and Cloud Run",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
